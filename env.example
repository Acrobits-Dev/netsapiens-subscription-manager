# NetSapiens Subscription Management - Environment Configuration

# ===============================================
# NetSapiens API Configuration (Required)
# ===============================================

# Schemes default to https if omitted; trailing slashes are removed automatically.
# NetSapiens API base URL (with scheme, e.g., https://; trailing slash optional)
NS_API_HOST=https://sipns.example.net

# OAuth credentials for NetSapiens API
NS_USERNAME=user@domain
NS_PASSWORD=your-password
NS_CLIENT_ID=your-client-id
NS_CLIENT_SECRET=your-client-secret

# ===============================================
# Callback Configuration (Required)
# ===============================================

# Schemes default to https if omitted; trailing slashes are removed automatically.
# Callback base URL (with scheme, e.g., https://; trailing slash optional)
CALLBACK_HOST=https://api.example.com

# Password for callback authentication
CALLBACK_PASSWORD=your-callback-password

# Cloud identifier
CLOUD_ID=your-cloud-id

# ===============================================
# Optional Configuration
# ===============================================

# Domain for editable version (leave empty if not needed)
EDITABLE_VERSION_DOMAIN=

# Comma-separated list of allowed domains (leave empty to allow all)
# Example: Domain1,Domain2,Domain3
# Note: Cannot be used together with NS_RESELLERS
ALLOWED_DOMAINS=

# Comma-separated list of disallowed domains (leave empty to allow all)
# Note: Cannot be used together with ALLOWED_DOMAINS.
# May be combined with NS_RESELLERS to further exclude domains from the
# reseller-selected set.
DISALLOWED_DOMAINS=

# Comma-separated list of reseller names used to select domains by reseller
# (leave empty to disable reseller-based selection).
# Example: Acme_Networks,Globex_Telecom
# When set, only domains whose 'reseller' field exactly matches an entry in this
# list (case-sensitive) are managed.
# Note: Cannot be used together with ALLOWED_DOMAINS (they are mutually
# exclusive). May be combined with DISALLOWED_DOMAINS.
NS_RESELLERS=
