# NetSapiens Subscription Management - Environment Configuration

# ===============================================
# NetSapiens API Configuration (Required)
# ===============================================

# Schemes default to https if omitted; trailing slashes are removed automatically.
# NetSapiens API base URL (with scheme, e.g., https://; trailing slash optional)
NS_API_HOST=https://sipns.example.net

# OAuth credentials for NetSapiens API
NS_USERNAME=user@domain
NS_PASSWORD=your-password
NS_CLIENT_ID=your-client-id
NS_CLIENT_SECRET=your-client-secret

# ===============================================
# Callback Configuration (Required)
# ===============================================

# Schemes default to https if omitted; trailing slashes are removed automatically.
# Callback base URL (with scheme, e.g., https://; trailing slash optional)
CALLBACK_HOST=https://api.example.com

# Password for callback authentication
CALLBACK_PASSWORD=your-callback-password

# Cloud identifier
CLOUD_ID=your-cloud-id

# ===============================================
# Domain Selection
# ===============================================

# Active and editable domains are not configured here. Every run loads them from
#   GET {CALLBACK_HOST}/netsapiens/callbacks/{CLOUD_ID}/active-domains?password={CALLBACK_PASSWORD}
# using the exact CLOUD_ID above and its connector callback password.
# - activeDomains: domains whose subscriptions are managed (intersected with NetSapiens domains).
# - editableDomains: domains whose callbacks are routed to "{CLOUD_ID}*".
# An empty activeDomains list means no domain is managed and existing managed
# subscriptions are removed. If the endpoint fails or returns an invalid payload,
# the run stops before any subscription change. There is no configuration fallback;
# ALLOWED_DOMAINS, DISALLOWED_DOMAINS, NS_RESELLERS and EDITABLE_VERSION_DOMAIN are
# no longer read.
